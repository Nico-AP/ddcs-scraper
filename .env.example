# Copy to .env and fill in. Variables set in the environment take precedence.

# ==== Required ====
# Base URL of the ddcs-app instance, without a path.
DDCS_API_URL=https://ddcs.example.org
# Token of an account with the permission "Can claim scrape targets and submit
# scraped results" (see docs/8_scraper.md in ddcs-app, "External scrapers").
DDCS_API_TOKEN=

# ==== Optional; these are the defaults ====
# Name of this instance, stored with the videos it claims. Defaults to the
# host name.
#DDCS_SCRAPER_ID=
# Videos claimed per round (1 to 500). Claim only what can be scraped within
# the server's lease (60 minutes by default).
#DDCS_CLAIM_LIMIT=100
# Results sent per request (1 to 50). One result can be tens of kilobytes.
#DDCS_SUBMIT_BATCH_SIZE=10
# Seconds to wait before asking again when the queue is empty or the server
# cannot be reached.
#DDCS_IDLE_SECONDS=300

# Minimum seconds between the starts of two video-page requests.
#TIKTOK_RATE_DELAY=1.0
# Random variation of that interval as a fraction (0.3 = +/-30%); 0 = off.
#TIKTOK_RATE_JITTER=0.3
# Seconds to wait before each caption download.
#TIKTOK_CAPTION_DELAY=0.0
# Also download each video's original-language caption.
#TIKTOK_FETCH_CAPTIONS=True

#LOG_LEVEL=INFO
